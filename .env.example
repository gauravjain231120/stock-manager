# Copy to .env.local for local dev.

# LOCAL: project replica set on 27018 (start with `npm run db:up`)
MONGODB_URI=mongodb://127.0.0.1:27018/stockmanager?replicaSet=rs0

# PRODUCTION (Vercel): use a MongoDB Atlas SRV string. Atlas is always a replica
# set, so transactions work out of the box. Set this in the Vercel dashboard, not
# in a committed file.
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/stockmanager?retryWrites=true&w=majority

# Marketplace mode: "simulate" (default, no credentials) or "live".
MARKETPLACE_MODE=simulate

# Protects the Vercel Cron endpoint (/api/cron/poll). Set this in Vercel.
# CRON_SECRET=change-me

# --- Live marketplace credentials (only when MARKETPLACE_MODE=live) ---
# Amazon SP-API:
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# AMAZON_REFRESH_TOKEN=
# AMAZON_SELLER_ID=
# AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV   # amazon.in
# Flipkart Seller API:
# FLIPKART_APP_ID=
# FLIPKART_APP_SECRET=
# Myntra PPMP (or point the adapter at an Increff/Unicommerce connector):
# MYNTRA_MERCHANT_ID=
# MYNTRA_SECRET_KEY=
# MYNTRA_FACILITY_CODE=

# Login (defaults baked into the app; override here / in Vercel to change them)
# AUTH_USERNAME=rangrooh
# AUTH_PASSWORD=rangrooh@123
# AUTH_TOKEN=replace-with-a-long-random-string

# Sister order-alert-bot deployment, for resolving a Myntra return tracking id
# to SKU/size/photo on the Returns page (see PROJECT.md). Secret must match
# RESOLVE_RETURN_SECRET set on that project.
# MYNTRA_BOT_URL=https://bot-ruby-pi.vercel.app
# MYNTRA_BOT_RESOLVE_SECRET=
